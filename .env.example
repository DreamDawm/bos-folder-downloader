# 复制为 .env 并填入真实值;.env 已被 .gitignore 忽略,切勿提交
# 程序会自动加载本文件,无需手动 source(跨 Windows / macOS / Linux 通用)
# 格式为 KEY=value,等号两侧不要留空格,值含特殊字符时可用引号包裹
BOS_ACCESS_KEY_ID=你的AK
BOS_SECRET_ACCESS_KEY=你的SK
BOS_ENDPOINT=bj.bcebos.com
BOS_BUCKET=你的桶名称

# SFTP 上传配置(bos-upload 使用)
SFTP_HOST=10.75.13.59
SFTP_PORT=22
SFTP_USERNAME=你的SFTP用户名
SFTP_PASSWORD=你的SFTP密码
SFTP_REMOTE_BASE=/upload

# S3 兼容存储凭据(s3-upload 和 s3-url 使用;非敏感配置见 config/s3.yml)
S3_ACCESS_KEY_ID=你的S3_AK
S3_SECRET_ACCESS_KEY=你的S3_SK
