#!/bin/sh

while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/develop)
            echo "禁止直接推送 develop；请通过 GitHub Pull Request 合并。" >&2
            exit 1
            ;;
        refs/heads/main)
            if [ "$BOS_RELEASE_PUSH" != "1" ]; then
                echo "禁止直接推送 main；请使用 scripts/release.ps1 正式发布。" >&2
                exit 1
            fi
            ;;
    esac
done

exit 0
